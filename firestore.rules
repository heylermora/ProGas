rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function activeUser() { return signedIn() && profile().data.active == true; }
    function hasRole(role) {
      return activeUser() && profile().data.roles is list && role in profile().data.roles;
    }
    function isStaff() { return hasRole('admin') || hasRole('colaborador'); }

    // Registration is restricted to the caller's least-privileged profile.
    // Staff accounts and role changes must be handled by a trusted backend.
    match /users/{userId} {
      allow create: if signedIn()
        && userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.roles == ['customer']
        && request.resource.data.active == true;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || hasRole('admin'));
      allow update, delete: if hasRole('admin');
    }

    // Public catalogue. Do not keep private/internal fields in these documents.
    match /Products/{documentId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /Sponsors/{documentId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }
    match /CategorySettings/{documentId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }
    match /SponsorDisplaySettings/{documentId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }
    match /Territories/{documentId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // These collections contain PII or financial/operational information.
    // Anonymous creation and lookup must use a trusted backend that returns a
    // safe projection rather than direct Firestore access.
    match /Orders/{documentId} { allow read, write: if isStaff(); }
    match /Clients/{documentId} { allow read, write: if isStaff(); }
    match /Expenses/{documentId} { allow read, write: if isStaff(); }
    match /Closings/{documentId} { allow read, write: if isStaff(); }
    match /Dashboard/{documentId} {
      allow read: if isStaff();
      allow write: if false;
    }
    match /ExchangeRate/{documentId} {
      allow read: if isStaff();
      allow write: if hasRole('admin');
    }

    // Anonymous, immutable measurements. URLs must belong to an active public business.
    match /PublicAnalyticsEvents/{eventId} {
      function publishedLink(d) {
        let sponsor = get(/databases/$(database)/documents/Sponsors/$(d.businessId)).data;
        return (!('active' in sponsor) || sponsor.active != false)
          && ((('links' in sponsor) && sponsor.links is list
              && (d.url in sponsor.links || (d.network == 'email' && d.url.matches('mailto:.*') && d.url.split('mailto:')[1] in sponsor.links)))
            || (('socialLinks' in sponsor) && sponsor.socialLinks is map
              && d.network in sponsor.socialLinks
              && (d.url == sponsor.socialLinks[d.network]
                || (d.network == 'email' && d.url == 'mailto:' + sponsor.socialLinks[d.network]))));
      }
      allow create: if request.resource.data.keys().hasAll(['type', 'sessionId', 'digest', 'businessId', 'url', 'network', 'source', 'createdAt'])
        && request.resource.data.keys().hasOnly(['type', 'sessionId', 'digest', 'businessId', 'url', 'network', 'source', 'createdAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('[a-f0-9-]{36}')
        && request.resource.data.digest is string && request.resource.data.digest.matches('[a-f0-9]{64}')
        && eventId == request.resource.data.sessionId + '_' + request.resource.data.type + '_' + request.resource.data.digest
        && request.resource.data.createdAt == request.time
        && request.resource.data.businessId is string && request.resource.data.businessId.size() <= 128
        && request.resource.data.url is string && request.resource.data.url.size() <= 2048
        && request.resource.data.network in ['', 'facebook', 'instagram', 'whatsapp', 'tiktok', 'email', 'website', 'other']
        && request.resource.data.source in ['home', 'mall', 'mall-preview', 'sponsor-strip']
        && ((request.resource.data.type in ['page_view', 'browse_click'] && request.resource.data.source == 'home'
            && request.resource.data.businessId == '' && request.resource.data.url == '' && request.resource.data.network == '')
          || (request.resource.data.type == 'link_click' && request.resource.data.businessId.matches('[^/]{1,128}') && publishedLink(request.resource.data)));
      allow read: if hasRole('admin');
      allow update, delete: if false;
    }

    // Deny every collection that has not been explicitly reviewed above.
    match /{document=**} { allow read, write: if false; }
  }
}
