# En producción, apunte estas variables a gateways propios con caché, cuotas y
# observabilidad. Los valores públicos son fallbacks para desarrollo.
REACT_APP_TERRITORY_API_URL=https://ubicaciones.paginasweb.cr
REACT_APP_GEOCODING_API_URL=https://nominatim.openstreetmap.org

# URL HTTPS pública del sitio, incluyendo la subcarpeta si corresponde.
# Sin este valor no se publican og:url, og:image ni twitter:image.
# Configurar antes de npm run build. No usar el dominio de Firebase ni una URL privada.
REACT_APP_SITE_URL=https://progasmemo.netlify.app
